#!/bin/bash
#SBATCH -J gsc_parallel            # Job name
#SBATCH -o gsc_parallel_%j.out     # Standard output log
#SBATCH -e gsc_parallel_%j.err     # Standard error log
#SBATCH -N 1                       # Total number of nodes
#SBATCH --ntasks=1                 # Number of tasks
#SBATCH --cpus-per-task=12         # CPUs per task (for parallel workers)
#SBATCH --mem=500G                 # Memory per node (max available)
#SBATCH --time=120:00:00           # Time limit (5 days for full training)

#SBATCH --mail-type=ALL                      # Request status by email
#SBATCH --mail-user=qh246@cornell.edu        # Email address to send results to.
#SBATCH -p compling

# ============================================================================
# PARALLEL GSCNET TRAINING WITH FLOAT32 OPTIMIZATION
# ============================================================================
# This script runs parallel gradient aggregation training.
# Each worker computes gradients on a subset of the data, then gradients
# are aggregated and applied by the master process.
#
# Memory Note (float32 via only_gscnet_speedup_sap_dtype.py):
#   - Each worker creates a GscNet with C matrix (~30 GB in float32)
#   - With 500GB limit: safe to run 10-12 workers
#   - Compared to float64: ~50% memory savings per worker
#
# Configuration:
#   - Workers: Adjust --cpus-per-task and NUM_WORKERS below
#   - Backend: 'ray' for cluster, 'multiprocessing' for single node
# ============================================================================

# Number of parallel workers (should be <= cpus-per-task)
# Memory calculation with float32 (from only_gscnet_speedup_sap_dtype.py):
#   - C matrix per worker: ~30 GB (float32)
#   - Master model: ~35 GB
#   - Overhead/buffers: ~5 GB per worker
#   - Total with 10 workers: 35 + (10 × 35) = ~385 GB
#   - Safe limit for 500GB: 10-12 workers
NUM_WORKERS=10

# Training configuration
# Strategy choice:
#   SCALE_TRIALS=false: 10x faster epochs, run more epochs (recommended for SGD)
#   SCALE_TRIALS=true:  same speed, better gradient quality per epoch
EPOCHS=10000            # 10x more epochs since each is 10x faster
TRIALS=50               # Base trials per epoch (split among workers)
SCALE_TRIALS=false      # Recommended: more frequent updates with noisy gradients
LRATE=0.1
CHECKPOINT_EVERY=1      # Save every epoch (set higher if disk space is limited)

# Backend: 'ray' or 'multiprocessing'
BACKEND=multiprocessing

# Output prefix for saved models
OUTPUT_PREFIX=parallel_sap_model

echo "======================================================================"
echo "PARALLEL GSC TRAINING JOB"
echo "======================================================================"
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $SLURM_NODELIST"
echo "CPUs: $SLURM_CPUS_PER_TASK"
echo "Memory: $SLURM_MEM_PER_NODE"
echo "Start Time: $(date)"
echo ""
echo "Configuration:"
echo "  Workers: $NUM_WORKERS"
echo "  Backend: $BACKEND"
echo "  Epochs: $EPOCHS"
echo "  Trials: $TRIALS"
echo "  Learning rate: $LRATE"
echo "  Checkpoint every: $CHECKPOINT_EVERY epochs"
echo "======================================================================"
echo ""

# Activate conda environment
source ~/.bashrc
eval "$(conda shell.bash hook)"
conda activate reverse_order

# Navigate to working directory
cd /home/qh246/gsc/more-gsc

# Print environment info
echo "----------------------------------------------------------------------"
echo "Python Environment:"
echo "----------------------------------------------------------------------"
which python3
python3 --version
echo ""

# Check if Ray is available
echo "----------------------------------------------------------------------"
echo "Checking Ray availability:"
echo "----------------------------------------------------------------------"
python3 -c "import ray; print(f'Ray version: {ray.__version__}')" 2>/dev/null || echo "Ray not installed, will use multiprocessing"
echo ""

# Print buffered statements immediately
export PYTHONUNBUFFERED=1

# ============================================================================
# Option 1: Run with multiprocessing (single node, no Ray needed)
# ============================================================================
if [ "$BACKEND" = "multiprocessing" ]; then
    echo "======================================================================"
    echo "Running with multiprocessing backend"
    echo "======================================================================"
    
    # Build scale-trials flag
    SCALE_FLAG=""
    if [ "$SCALE_TRIALS" = "true" ]; then
        SCALE_FLAG="--scale-trials"
    fi
    
    python3 -u train_parallel.py \
        --workers $NUM_WORKERS \
        --backend multiprocessing \
        --epochs $EPOCHS \
        --trials $TRIALS \
        $SCALE_FLAG \
        --lrate $LRATE \
        --checkpoint-every $CHECKPOINT_EVERY \
        --output-prefix $OUTPUT_PREFIX \
        --sparse \
        --compressed
fi

# ============================================================================
# Option 2: Run with Ray (can scale to multiple nodes)
# ============================================================================
if [ "$BACKEND" = "ray" ]; then
    echo "======================================================================"
    echo "Running with Ray backend"
    echo "======================================================================"
    
    # Start Ray head node (for single-node, Ray handles this automatically)
    # For multi-node, you'd need to start Ray on each node separately
    
    # Build scale-trials flag
    SCALE_FLAG=""
    if [ "$SCALE_TRIALS" = "true" ]; then
        SCALE_FLAG="--scale-trials"
    fi
    
    python3 -u train_parallel.py \
        --workers $NUM_WORKERS \
        --backend ray \
        --epochs $EPOCHS \
        --trials $TRIALS \
        $SCALE_FLAG \
        --lrate $LRATE \
        --checkpoint-every $CHECKPOINT_EVERY \
        --output-prefix $OUTPUT_PREFIX \
        --sparse \
        --compressed
fi

echo ""
echo "======================================================================"
echo "Job Completed"
echo "End Time: $(date)"
echo "======================================================================"

# List output files
echo ""
echo "Output files:"
ls -la ${OUTPUT_PREFIX}*.pkl 2>/dev/null || echo "No checkpoint files found"

